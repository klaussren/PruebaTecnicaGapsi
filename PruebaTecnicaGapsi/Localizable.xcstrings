      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching products..."
          }
        }
      }
    },
    "Buscar productos (ej. nintendo)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search products (e.g. nintendo)"
          }
        }
      }
    },
    "Búsquedas recientes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent searches"
          }
        }
      }
    },
    "Desde %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From %@"
          }
        }
      }
    },
    "El servicio no está disponible en este momento. Intenta más tarde." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service is not available right now. Please try again later."
          }
        }
      }
    },
    "El servicio rechazó la consulta. Revisa que la API key esté configurada en Config/Secrets.xcconfig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service rejected the request. Make sure the API key is set in Config/Secrets.xcconfig."
          }
        }
      }
    },
    "Escribe algo para buscar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type something to search."
          }
        }
      }
    },
    "Escribe lo que buscas, por ejemplo \"nintendo\", \"sony\" o \"computer\". Tus búsquedas aparecerán aquí." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type what you're looking for, for example \"nintendo\", \"sony\" or \"computer\". Your searches will appear here."
          }
        }
      }
    },
    "No encontramos productos para \"%@\". Prueba con otra palabra en inglés o una marca." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find products for \"%@\". Try another word in English or a brand name."
          }
        }
      }
    },
